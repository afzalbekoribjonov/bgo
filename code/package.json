{
  "name": "beshariq-superapp",
  "version": "0.1.0",
  "private": true,
  "description": "Beshariq tumani super-ilovasi: Taksi + Dostavka + Ovqat yetkazib berish",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "gateway:dev": "pnpm --filter @beshariq/gateway start:dev",
    "auth:dev": "pnpm --filter @beshariq/auth start:dev",
    "restaurant:dev": "pnpm --filter @beshariq/restaurant start:dev",
    "order:dev": "pnpm --filter @beshariq/order start:dev",
    "market:dev": "pnpm --filter @beshariq/market start:dev",
    "marketplace:dev": "pnpm --filter @beshariq/marketplace start:dev",
    "support:dev": "pnpm --filter @beshariq/support start:dev",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^8.57.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.65.0"
  }
}
