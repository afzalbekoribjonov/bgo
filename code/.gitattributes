# Qator oxirini normallashtirish (cross-platform monorepo)
* text=auto eol=lf

# Shell skriptlar har doim LF (Linux serverda ishlaydi)
*.sh text eol=lf

# Windows skriptlar CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binar fayllar (diff/normalizatsiya yo'q)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.osm.pbf binary
*.keystore binary
