# Marketplace servisi (Do'konlar + Qurilishda foydali)
MARKETPLACE_PORT=4006
NODE_ENV=development

# Ma'lumot bazasi (PostgreSQL — Docker compose)
DATABASE_URL="postgresql://beshariq:beshariq_dev_password@localhost:5432/marketplace_db?schema=public&connection_limit=10"

# JWT (auth servisi bilan BIR XIL access secret)
JWT_ACCESS_SECRET=dev_access_secret_change_me

# Servislararo
INTERNAL_API_KEY=dev_internal_key

# ImageKit (rasm yuklash) — kalitlar bo'lmasa upload-auth 503 qaytaradi,
# boshqa hamma narsa (katalog/chat) ishlayveradi.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
