# Restaurant/Catalog servisi
RESTAURANT_PORT=4003
NODE_ENV=development

# Ma'lumot bazasi (PostgreSQL — Docker compose)
DATABASE_URL="postgresql://beshariq:beshariq_dev_password@localhost:5432/restaurant_db?schema=public&connection_limit=10"

# JWT (auth servisi bilan BIR XIL access secret — boshqaruv himoyasi uchun)
JWT_ACCESS_SECRET=dev_access_secret_change_me

# Servislararo (auth servisiga telefon->foydalanuvchi so'rovlari uchun;
# order servisiga oshxonani o'chirishdan oldin faol buyurtma tekshiruvi uchun)
AUTH_SERVICE_URL=http://localhost:4001
ORDER_SERVICE_URL=http://localhost:4004
INTERNAL_API_KEY=dev_internal_key

# Dev: namunaviy oshxonalar bilan to'ldirish
SEED_ON_START=true

# ImageKit (rasm yuklash) — kalitlar bo'lmasa lokal diskka zaxiralanadi,
# boshqa hamma narsa (katalog/menyu) ishlayveradi.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
