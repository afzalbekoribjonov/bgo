// Order servisi — ma'lumot modeli (order_db). plan/03-databases.md
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  FOOD
  TAXI
  DELIVERY
}

/** Narx/tarif sozlamasi (MVP: yagona global qator). plan/11-pricing-promo.md */
model Tariff {
  id                    String   @id @default("default")
  deliveryFee           Int      @default(5000) // mijozdan, so'm
  foodCommissionPercent Int      @default(12) // oshxona ulushi, %
  updatedAt             DateTime @updatedAt

  @@map("tariffs")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  ASSIGNED
  IN_PROGRESS
  PICKED_UP
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentType {
  CASH
  PAYME
  CLICK
  UZUM
}

model Order {
  id            String      @id @default(uuid())
  publicNo      Int         @unique @default(autoincrement())
  customerId    String
  driverId      String? // biriktirilgan haydovchi (kuryer)
  type          OrderType
  restaurantId  String
  items         Json // OrderItem[] snapshot
  itemsTotal    Int
  deliveryFee   Int
  commission    Int         @default(0) // bizning ulush (oshxona komissiyasi), so'm
  total         Int
  paymentType   PaymentType
  address       Json // { text, lat?, lng? }
  status        OrderStatus @default(PENDING)
  statusHistory Json // OrderStatusEntry[]
  createdAt     DateTime    @default(now())

  @@index([customerId])
  @@index([restaurantId])
  @@index([driverId])
  @@map("orders")
}
