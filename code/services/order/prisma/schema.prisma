// Order servisi — ma'lumot modeli (order_db). plan/03-databases.md
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  FOOD
  TAXI
  DELIVERY
}

/** Xizmat hududi (tuman) — admin boshqaradi, kengaytiriladi. plan/12-maps-navigation.md */
model ServiceArea {
  id        String   @id @default(uuid())
  name      String // "Beshariq tumani"
  centerLat Float
  centerLng Float
  boundary  Json // GeoJSON Polygon koordinatalari: [[[lng,lat],...]]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  places Place[]

  @@map("service_areas")
}

/** Hududdagi nomli joy (xaritada marker). */
model Place {
  id        String      @id @default(uuid())
  areaId    String
  area      ServiceArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  label     String
  lat       Float
  lng       Float
  category  String? // "landmark", "mahalla", ...
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([areaId])
  @@map("places")
}

enum PromoType {
  PERCENT
  FIXED
}

/** Promokod / aksiya. plan/11-pricing-promo.md */
model PromoCode {
  id          String    @id @default(uuid())
  code        String    @unique
  type        PromoType @default(PERCENT)
  value       Int // PERCENT: 0-100; FIXED: so'm
  minOrder    Int       @default(0) // minimal itemsTotal
  maxDiscount Int? // PERCENT uchun maksimal chegirma (so'm)
  active      Boolean   @default(true)
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@map("promo_codes")
}

/** Narx/tarif sozlamasi (MVP: yagona global qator). plan/11-pricing-promo.md */
model Tariff {
  id                    String   @id @default("default")
  deliveryFee           Int      @default(5000) // mijozdan, so'm
  foodCommissionPercent Int      @default(12) // oshxona ulushi, %
  courierSharePercent   Int      @default(80) // yetkazish narxidan haydovchi ulushi, %
  taxiBaseFare          Int      @default(5000) // taksi boshlang'ich haq, so'm
  taxiPerKm             Int      @default(2000) // har km uchun, so'm
  taxiMinFare           Int      @default(8000) // minimal taksi haqi, so'm
  taxiCommissionPercent Int      @default(15) // taksi haqidan platforma ulushi, %
  parcelBaseFare          Int    @default(4000) // dostavka boshlang'ich haq, so'm
  parcelPerKm             Int    @default(1500) // har km uchun, so'm
  parcelMinFare           Int    @default(6000) // minimal dostavka haqi, so'm
  parcelCommissionPercent Int    @default(15) // dostavka haqidan platforma ulushi, %
  updatedAt             DateTime @updatedAt

  @@map("tariffs")
}

enum TaxiStatus {
  PENDING // yaratildi, haydovchi kutilmoqda
  ACCEPTED // haydovchi qabul qildi
  IN_PROGRESS // yo'lovchi olindi, yo'lda
  COMPLETED // yakunlandi
  CANCELLED
}

/** Taksi safari (alohida — ovqat Order modelidan ajratilgan). plan/06-driver-app.md */
model TaxiTrip {
  id            String      @id @default(uuid())
  publicNo      Int         @unique @default(autoincrement())
  customerId    String
  driverId      String? // biriktirilgan haydovchi
  pickup        Json // { text, lat, lng }
  destination   Json // { text, lat, lng }
  distanceKm    Float
  fare          Int // umumiy haq (so'm)
  commission    Int         @default(0) // platforma ulushi
  driverEarning Int         @default(0) // haydovchiga
  status        TaxiStatus  @default(PENDING)
  paymentType   PaymentType @default(CASH)
  statusHistory Json
  createdAt     DateTime    @default(now())

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@map("taxi_trips")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  ASSIGNED
  IN_PROGRESS
  PICKED_UP
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentType {
  CASH
  PAYME
  CLICK
  UZUM
}

model Order {
  id            String      @id @default(uuid())
  publicNo      Int         @unique @default(autoincrement())
  customerId    String
  driverId      String? // biriktirilgan haydovchi (kuryer)
  type          OrderType
  restaurantId  String
  items         Json // OrderItem[] snapshot
  itemsTotal    Int
  deliveryFee   Int
  commission    Int         @default(0) // bizning ulush (oshxona komissiyasi), so'm
  courierEarning Int        @default(0) // haydovchiga (yetkazish narxidan), so'm
  promoCode     String? // qo'llanilgan promokod
  discount      Int         @default(0) // chegirma, so'm
  total         Int
  paymentType   PaymentType
  address       Json // { text, lat?, lng? }
  status        OrderStatus @default(PENDING)
  statusHistory Json // OrderStatusEntry[]
  createdAt     DateTime    @default(now())

  @@index([customerId])
  @@index([restaurantId])
  @@index([driverId])
  @@map("orders")
}

enum ParcelStatus {
  PENDING // yaratildi, kuryer kutilmoqda
  ACCEPTED // kuryer qabul qildi
  PICKED_UP // jo'natuvchidan olindi
  DELIVERED // qabul qiluvchiga yetkazildi
  CANCELLED
}

enum ParcelSize {
  SMALL
  MEDIUM
  LARGE
}

/** Dostavka (pochta/posilka) — alohida model. plan/06-driver-app.md */
model ParcelDelivery {
  id             String       @id @default(uuid())
  publicNo       Int          @unique @default(autoincrement())
  customerId     String
  driverId       String? // biriktirilgan kuryer
  pickup         Json // { text, lat, lng }
  destination    Json // { text, lat, lng }
  distanceKm     Float
  size           ParcelSize   @default(SMALL)
  recipientName  String
  recipientPhone String
  note           String?
  fare           Int
  commission     Int          @default(0)
  driverEarning  Int          @default(0)
  status         ParcelStatus @default(PENDING)
  paymentType    PaymentType  @default(CASH)
  statusHistory  Json
  createdAt      DateTime     @default(now())

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@map("parcel_deliveries")
}
