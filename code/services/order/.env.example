# Order servisi
ORDER_PORT=4004
NODE_ENV=development

# Ma'lumot bazasi (PostgreSQL — Docker compose)
DATABASE_URL="postgresql://beshariq:beshariq_dev_password@localhost:5432/order_db?schema=public&connection_limit=10"

# JWT (auth servisi bilan BIR XIL access secret bo'lishi shart)
JWT_ACCESS_SECRET=dev_access_secret_change_me

# Bog'liq servislar
RESTAURANT_SERVICE_URL=http://localhost:4003
AUTH_SERVICE_URL=http://localhost:4001
MARKET_SERVICE_URL=http://localhost:4005

# Push bildirishnoma (auth internal endpoint) — auth bilan BIR XIL kalit
INTERNAL_API_KEY=dev_internal_key

# OSRM (marshrut + yo'lga yopishtirish, self-hosted) — infra/osrm/README.md
OSRM_URL=http://localhost:5000
