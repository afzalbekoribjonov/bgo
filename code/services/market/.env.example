# Market servisi (Beshariq Market katalogi)
MARKET_PORT=4005
NODE_ENV=development

# Ma'lumot bazasi (PostgreSQL — Docker compose)
DATABASE_URL="postgresql://beshariq:beshariq_dev_password@localhost:5432/market_db?schema=public&connection_limit=10"

# JWT (auth servisi bilan BIR XIL access secret)
JWT_ACCESS_SECRET=dev_access_secret_change_me

# Servislararo (order servisi stock band qilish uchun chaqiradi;
# UserInfoClient — support chat/buyurtmalarda mijoz ism/telefonini olish uchun)
INTERNAL_API_KEY=dev_internal_key
AUTH_SERVICE_URL=http://localhost:4001

# ImageKit (rasm yuklash) — kalitlar bo'lmasa upload-auth 503 qaytaradi,
# boshqa hamma narsa (katalog/layk/izoh/chat) ishlayveradi.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
