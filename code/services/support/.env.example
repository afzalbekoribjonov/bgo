# Qo'llab-quvvatlash servisi (AI chat + FAQ)
SUPPORT_PORT=4007
NODE_ENV=development

# Ma'lumot bazasi (PostgreSQL — Docker compose)
DATABASE_URL="postgresql://beshariq:beshariq_dev_password@localhost:5432/support_db?schema=public"

# JWT (auth servisi bilan BIR XIL access secret)
JWT_ACCESS_SECRET=dev_access_secret_change_me

# Servislararo (mijoz/haydovchi ism-familiyasini olish, narx ma'lumotini olish)
INTERNAL_API_KEY=dev_internal_key
AUTH_SERVICE_URL=http://localhost:4001
ORDER_SERVICE_URL=http://localhost:4004

# Google Gemini — AI suhbat. Kalit bo'lmasa AI chat ishlamaydi, lekin
# tayyor javoblar (FAQ) va admin bilan yozishish baribir ishlayveradi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
