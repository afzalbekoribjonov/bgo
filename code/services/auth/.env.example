# Auth servisi muhit o'zgaruvchilari
AUTH_PORT=4001
NODE_ENV=development

# Ma'lumot bazasi (PostgreSQL — Docker compose orqali)
DATABASE_URL="postgresql://beshariq:beshariq_dev_password@localhost:5432/auth_db?schema=public&connection_limit=10"

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Admin bootstrap: shu raqamlar loginda 'admin' rolini oladi (vergul bilan)
ADMIN_PHONES=+998900000000

# SMS — dev rejimda kod logga chiqadi, SMS yuborilmaydi (real provayder hali ulanmagan)
SMS_DEV_MODE=true

# Push (FCM, firebase-admin) — dev rejimda haqiqiy FCM chaqirilmaydi (log + soni)
FCM_DEV_MODE=true
# Jonli yetkazish: FCM_ENABLED=true + FCM_SERVICE_ACCOUNT (service account JSON yo'li).
# SDK access tokenni o'zi yaratadi. JSON Firebase Console > Project settings >
# Service accounts > Generate new private key. Faylni gitignore'da saqlang.
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT=./firebase-service-account.json

# Servislararo (internal) endpointlar kaliti (order servisi push triggeri uchun)
INTERNAL_API_KEY=dev_internal_key
