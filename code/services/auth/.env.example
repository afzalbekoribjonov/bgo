# Auth servisi muhit o'zgaruvchilari
AUTH_PORT=4001
NODE_ENV=development

# Ma'lumot bazasi (PostgreSQL — Docker compose orqali)
DATABASE_URL="postgresql://beshariq:beshariq_dev_password@localhost:5432/auth_db?schema=public"

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Admin bootstrap: shu raqamlar loginda 'admin' rolini oladi (vergul bilan)
ADMIN_PHONES=+998900000000

# SMS (Eskiz) — dev rejimda kod logga chiqadi, SMS yuborilmaydi
SMS_DEV_MODE=true
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Push (FCM) — dev rejimda haqiqiy FCM chaqirilmaydi (log + yetkazilgan soni)
FCM_DEV_MODE=true
# Jonli: FCM_ENABLED=true + FCM_PROJECT_ID=... + FCM_ACCESS_TOKEN=... (service account OAuth2)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# Servislararo (internal) endpointlar kaliti (order servisi push triggeri uchun)
INTERNAL_API_KEY=dev_internal_key
