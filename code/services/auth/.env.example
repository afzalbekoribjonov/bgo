# Auth servisi muhit o'zgaruvchilari
AUTH_PORT=3001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# SMS (Eskiz) — dev rejimda kod logga chiqadi, SMS yuborilmaydi
SMS_DEV_MODE=true
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
