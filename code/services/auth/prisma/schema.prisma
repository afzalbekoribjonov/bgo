// Auth servisi — ma'lumot modeli (auth_db). plan/03-databases.md
generator client {
  provider = "prisma-client-js"
  // Har servisga alohida output (pnpm monorepo'da client'lar to'qnashmasligi uchun)
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  phone             String    @unique
  fullName          String?
  locale            String    @default("uz")
  roles             String[]  @default(["customer"])
  consentPrivacy    Boolean   @default(false)
  consentVersion    String?
  consentAcceptedAt DateTime?

  // Admin bloklashi (masalan haydovchidan shikoyat asosida) — bloklangan
  // foydalanuvchi OTP orqali kira olmaydi (aniq sabab bilan rad etiladi).
  isBlocked     Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?

  // Admin xabarlari (CustomerMessage) oxirgi o'qilgan payt — badge uchun.
  messagesReadAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("users")
}

/** Mijozning saqlangan yetkazib berish manzili. plan/05-customer-app.md */
model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String // "Uy", "Ish", ...
  text      String // to'liq manzil matni
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

enum PartnerType {
  RESTAURANT
  DRIVER
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

/** FCM push qurilma tokeni (foydalanuvchi ↔ qurilma). plan/10-auth-security.md */
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // FCM registration token
  platform  String   @default("android") // android | ios | web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

/** Telefon ↔ Telegram chat bog'lanishi (OTP'ni bot orqali yuborish uchun). */
model TelegramLink {
  phone     String   @id // +998...
  chatId    String // Telegram chat/user id
  username  String? // @username (ixtiyoriy)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_links")
}

/**
 * Haydovchi profili — admin qo'shadi (ro'yxatdan o'tishsiz), haydovchi 8 xonali
 * kod bilan kiradi. Hamma narsa telefon raqami orqali bog'lanadi.
 * plan/06-driver-app.md
 */
model DriverProfile {
  id       String  @id @default(uuid())
  userId   String  @unique // auth User bilan bog'lanish
  phone    String  @unique // login + barcha ma'lumotni bog'lovchi
  fullName String // FISH
  age      Int?

  // Avtomobil ma'lumotlari
  carName     String? // nomi/modeli
  carYear     Int?
  plateNumber String? // davlat raqami (tех pasport)
  licenseInfo String? // haydovchilik guvohnomasi ma'lumotlari

  // Login (admin beradi) + holat
  loginCode String // 8 xonali kod
  isActive  Boolean @default(true) // admin butunlay o'chirishi mumkin (doimiy)
  isOnline  Boolean @default(false) // Liniyaga chiqish / Ishni yakunlash
  isComfort Boolean @default(false) // Comfort tarifi (faqat admin yoqadi)

  // Vaqtinchalik bloklash (masalan ketma-ket bekor qilishlar uchun) — isActive'dan
  // farqli, muddati tugagach o'zi tugaydi. blockedUntil o'tmishda/null bo'lsa
  // bloklanmagan hisoblanadi. Darhol blokdan chiqarish uchun admin blockedUntil'ni
  // null qiladi (masalan haydovchi ofisga kelib jarima to'lagach).
  blockedUntil DateTime?
  blockReason  String?

  // Ketma-ket (uzluksiz) bekor qilingan buyurtmalar soni — har muvaffaqiyatli
  // yakunlangan buyurtmada 0'ga tushadi. services/order har cancel/complete
  // hodisasida internal endpoint orqali yangilaydi (Shubhali haydovchilar).
  consecutiveCancellations Int @default(0)

  // Hisob (komissiya shu balansdan olinadi — haydovchida pul bo'lishi shart)
  balance Int @default(0)

  // Reyting (admin yoki mijoz bahosi asosida — 0-5)
  rating Float @default(0)

  // Xabarlar oxirgi o'qilgan payt (badge: shundan keyingilar "yangi")
  messagesReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("driver_profiles")
}

/**
 * Admin → haydovchi xabari. driverUserId null bo'lsa — barcha haydovchilarga
 * (broadcast). Haydovchi javob yozolmaydi (faqat o'qish).
 */
model DriverMessage {
  id           String   @id @default(uuid())
  driverUserId String? // null = hammaga
  title        String?
  body         String
  createdAt    DateTime @default(now())

  @@index([driverUserId, createdAt])
  @@map("driver_messages")
}

/**
 * Admin → mijoz xabari. customerId null bo'lsa — barcha mijozlarga
 * (broadcast). Mijoz javob yozolmaydi (faqat o'qish). DriverMessage bilan
 * bir xil naqsh.
 */
model CustomerMessage {
  id         String   @id @default(uuid())
  customerId String? // null = hammaga
  title      String?
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("customer_messages")
}

/** Haydovchi hisobini to'ldirish tarixi (admin/office to'ldiradi). */
model DriverTopup {
  id        String   @id @default(uuid())
  driverId  String // DriverProfile.id
  amount    Int
  note      String?
  // false = haydovchiga ko'rsatilmaydi (masalan bekor qilish jarimasi mijoz
  // aybi bilan bo'lganda sezdirmasdan qaytariladigan tuzatish). Balans darhol
  // to'g'ri bo'ladi, faqat bu qatorlar tarixda ko'rinmaydi.
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([driverId])
  @@map("driver_topups")
}

/** Hamkorlik arizasi (oshxona/haydovchi). plan/08-admin-workspace.md */
model PartnerApplication {
  id        String        @id @default(uuid())
  userId    String
  phone     String
  fullName  String
  type      PartnerType
  note      String?
  status    PartnerStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("partner_applications")
}

/** Oshxona paneli login/parol kirishi (admin yaratadi). plan/07-restaurant-app.md */
model KitchenCredential {
  id           String   @id @default(uuid())
  restaurantId String   @unique
  username     String   @unique
  passwordHash String // scrypt: salt:hash
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("kitchen_credentials")
}

/** Sotuvchi paneli login/parol kirishi (admin yaratadi) — Do'konlar/Qurilish. */
model SellerCredential {
  id           String   @id @default(uuid())
  sellerId     String   @unique
  username     String   @unique
  passwordHash String // scrypt: salt:hash
  sellerType   String // SHOP | CONSTRUCTION
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("seller_credentials")
}
