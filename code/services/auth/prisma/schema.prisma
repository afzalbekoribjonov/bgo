// Auth servisi — ma'lumot modeli (auth_db). plan/03-databases.md
generator client {
  provider = "prisma-client-js"
  // Har servisga alohida output (pnpm monorepo'da client'lar to'qnashmasligi uchun)
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  phone             String    @unique
  fullName          String?
  locale            String    @default("uz")
  roles             String[]  @default(["customer"])
  consentPrivacy    Boolean   @default(false)
  consentVersion    String?
  consentAcceptedAt DateTime?
  createdAt         DateTime  @default(now())

  @@map("users")
}

enum PartnerType {
  RESTAURANT
  DRIVER
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

/** Hamkorlik arizasi (oshxona/haydovchi). plan/08-admin-workspace.md */
model PartnerApplication {
  id        String        @id @default(uuid())
  userId    String
  phone     String
  fullName  String
  type      PartnerType
  note      String?
  status    PartnerStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("partner_applications")
}
