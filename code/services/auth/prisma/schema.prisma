// Auth servisi — ma'lumot modeli (auth_db). plan/03-databases.md
generator client {
  provider = "prisma-client-js"
  // Har servisga alohida output (pnpm monorepo'da client'lar to'qnashmasligi uchun)
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  phone             String    @unique
  fullName          String?
  locale            String    @default("uz")
  roles             String[]  @default(["customer"])
  consentPrivacy    Boolean   @default(false)
  consentVersion    String?
  consentAcceptedAt DateTime?
  createdAt         DateTime  @default(now())

  @@map("users")
}

/** Mijozning saqlangan yetkazib berish manzili. plan/05-customer-app.md */
model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String // "Uy", "Ish", ...
  text      String // to'liq manzil matni
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

enum PartnerType {
  RESTAURANT
  DRIVER
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

/** FCM push qurilma tokeni (foydalanuvchi ↔ qurilma). plan/10-auth-security.md */
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // FCM registration token
  platform  String   @default("android") // android | ios | web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

/** Telefon ↔ Telegram chat bog'lanishi (OTP'ni bot orqali yuborish uchun). */
model TelegramLink {
  phone     String   @id // +998...
  chatId    String // Telegram chat/user id
  username  String? // @username (ixtiyoriy)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_links")
}

/** Hamkorlik arizasi (oshxona/haydovchi). plan/08-admin-workspace.md */
model PartnerApplication {
  id        String        @id @default(uuid())
  userId    String
  phone     String
  fullName  String
  type      PartnerType
  note      String?
  status    PartnerStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("partner_applications")
}
