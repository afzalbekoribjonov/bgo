# ====== Beshariq Super-App — namuna muhit o'zgaruvchilari ======
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring.
# .env hech qachon git'ga qo'shilmaydi (sirlar).

# --- Umumiy ---
NODE_ENV=development

# --- API Gateway ---
GATEWAY_PORT=4000

# --- PostgreSQL (infra/docker) ---
POSTGRES_USER=beshariq
POSTGRES_PASSWORD=beshariq_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT (Auth servisi) ---
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# --- SMS (Eskiz.uz) — keyingi fazada ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_DEV_MODE=true

# --- Media (Cloudflare R2) — keyingi fazada ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# --- Xarita ---
OSRM_URL=http://localhost:5000
MAPTILER_KEY=
